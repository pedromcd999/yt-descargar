#!/usr/bin/env bash
# Descarga videos/playlists (YouTube y otros sitios) con yt-dlp. Pregunta URL,
# cuántos videos (si es playlist) y resolución; las playlists se guardan en una
# carpeta con su nombre y videos numerados. Dependencias, runtime JS y yt-dlp
# se instalan solos (helpers en lib.sh, que se descarga sola la primera vez).
#
# CRÉDITOS: las descargas las realiza yt-dlp (github.com/yt-dlp/yt-dlp, licencia
# Unlicense). Este script es un wrapper: baja el binario OFICIAL de yt-dlp desde
# sus releases y lo ejecuta. No contiene ni modifica el código de yt-dlp.

set -euo pipefail

# ── Auto-bootstrap de helpers (lib.sh) ──
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$LIB_DIR/lib.sh"
if [[ ! -f "$LIB" ]]; then
  command -v curl >/dev/null 2>&1 \
    || { echo "❌ Falta curl. Instálalo y vuelve a ejecutar." >&2; exit 1; }
  echo "▶ Descargando lib.sh (solo la primera vez)..."
  curl -fsSL --retry 3 -o "$LIB" \
    https://raw.githubusercontent.com/pedromcd999/yt-descargar/main/lib.sh \
    || { echo "❌ No se pudo descargar lib.sh. Revisa la conexión a internet." >&2; exit 1; }
fi
source "$LIB"

main() {
  ensure_deps
  ensure_ytdlp

  # Runtime JS para resolver los retos de YouTube
  JS_ARGS=()
  if command -v node >/dev/null 2>&1; then
    JS_ARGS=(--js-runtimes node)
  elif command -v bun >/dev/null 2>&1; then
    JS_ARGS=(--js-runtimes bun)
  fi

  # Cookies del navegador para superar el bloqueo anti-bot de
  # YouTube ("Sign in to confirm you're not a bot"). Desactivable: NO_COOKIES=1
  COOKIE_ARGS=()
  if [[ "${NO_COOKIES:-0}" != "1" ]]; then
    for br in firefox librewolf google-chrome chromium chromium-browser brave-browser microsoft-edge; do
      if command -v "$br" >/dev/null 2>&1; then
        case "$br" in
          librewolf) br=firefox ;;
          google-chrome) br=chrome ;;
          chromium-browser) br=chromium ;;
          brave-browser) br=brave ;;
          microsoft-edge) br=edge ;;
        esac
        COOKIE_ARGS=(--cookies-from-browser "$br")
        echo "🍪 Cookies de $br (anti-bot de YouTube)"
        break
      fi
    done
  fi

  # ── URL ──
  while true; do
    read -r -p "🔗 URL del video o playlist: " URL
    [[ -n "$URL" ]] && break
    echo "❌ Escribe una URL." >&2
  done

  # Clasifica el enlace: video | playlist | video+playlist
  if [[ "$URL" != *"list="* ]]; then
    URL_TYPE="video"
  elif [[ "$URL" == *"/playlist?"* ]]; then
    URL_TYPE="playlist"
  else
    URL_TYPE="video+playlist"
  fi

  YES_PLAYLIST=(); NO_PLAYLIST=(); PLAYLIST_ITEMS=(); OUTPUT_ARGS=()
  IS_PLAYLIST=0

  # ── Enlace con video Y playlist: que el usuario decida ──
  if [[ "$URL_TYPE" == "video+playlist" ]]; then
    echo "⚠ El enlace contiene un video Y una playlist. ¿Qué deseas?"
    echo "  1) Solo el video      2) Toda la playlist"
    while true; do
      read -r -p "Elige [1]: " COMBO
      COMBO="${COMBO:-1}"
      case "$COMBO" in
        1) NO_PLAYLIST=(--no-playlist); break ;;
        2) YES_PLAYLIST=(--yes-playlist); IS_PLAYLIST=1; break ;;
        *) echo "❌ Opción 1 o 2." >&2 ;;
      esac
    done
  elif [[ "$URL_TYPE" == "playlist" ]]; then
    YES_PLAYLIST=(--yes-playlist)
    IS_PLAYLIST=1
  fi

  # ── Pre-flight: ¿la URL responde? ¿cuántos videos? ──
  echo "▶ Verificando la URL..."
  if [[ "$IS_PLAYLIST" -eq 1 ]]; then
    PRE="$(quick_query "${YES_PLAYLIST[@]}" --print '%(playlist_count)s|%(id)s')"
    COUNT="${PRE%%|*}"
  else
    PRE="$(quick_query "${NO_PLAYLIST[@]}" --print '%(id)s')"
  fi

  if [[ -z "$PRE" ]]; then
    echo "⚠ La URL no responde o no es descargable con yt-dlp." >&2
    read -r -p "   ¿Intentar de todos modos? [N]: " FORZAR
    case "${FORZAR:-n}" in
      s | S | y | Y) ;;
      *) die "Cancelado. Revisa la URL o si el sitio permite descargas." ;;
    esac
  else
    if [[ "$IS_PLAYLIST" -eq 1 ]] && [[ "$COUNT" =~ ^[0-9]+$ ]]; then
      echo "✅ URL válida — la playlist tiene $COUNT videos."
    else
      echo "✅ URL válida"
    fi
  fi

  # ── Configuración de playlist ──
  if [[ "$IS_PLAYLIST" -eq 1 ]]; then
    OUTPUT_ARGS=(-o '%(playlist_title)s/%(playlist_index 03d)s - %(title)s.%(ext)s')
    [[ "$COUNT" =~ ^[0-9]+$ ]] || echo "(no se pudo obtener el número de videos)"
    while true; do
      read -r -p "🎞 ¿Cuántos videos? (Enter = todos, N = primeros N, a-b = rango): " QTY
      QTY="${QTY:-all}"
      case "$QTY" in
        all | todos) break ;;
        *)
          if [[ "$QTY" =~ ^[0-9]+$ ]]; then
            PLAYLIST_ITEMS=(--playlist-items "1-$QTY"); break
          elif [[ "$QTY" =~ ^[0-9]+-[0-9]+$ ]]; then
            PLAYLIST_ITEMS=(--playlist-items "$QTY"); break
          else
            echo "❌ Usa: Enter, N o a-b." >&2
          fi
          ;;
      esac
    done
  fi

  # ── Resolución ──
  while true; do
    read -r -p "🎚 Resolución (max|2160|1440|1080|720|480|360|audio) [max]: " RES
    RES="${RES:-max}"
    case "$RES" in
      max) FORMAT="bestvideo*+bestaudio/best"; EXTRA_ARGS=(); break ;;
      audio) FORMAT="bestaudio/best"; EXTRA_ARGS=(-x --audio-format mp3); break ;;
      2160 | 1440 | 1080 | 720 | 480 | 360)
        FORMAT="bv*[height<="$RES"]+ba/b[height<="$RES"]"; EXTRA_ARGS=(); break ;;
      *) echo "❌ Resolución inválida. Usa: max, 2160, 1440, 1080, 720, 480, 360 o audio." >&2 ;;
    esac
  done

  # ── Descarga ──
  echo ""
  echo "▶ Descargando (resolución: $RES) ..."
  trap 'echo ""; echo "⏸ Interrumpida. Repite el mismo comando y la misma URL para reanudar."' INT
  if "$YTDLP" --no-update "${JS_ARGS[@]+"${JS_ARGS[@]}"}" "${COOKIE_ARGS[@]+"${COOKIE_ARGS[@]}"}" -f "$FORMAT" \
      --retries 3 --socket-timeout 30 \
      "${YES_PLAYLIST[@]+"${YES_PLAYLIST[@]}"}" "${NO_PLAYLIST[@]+"${NO_PLAYLIST[@]}"}" \
      "${PLAYLIST_ITEMS[@]+"${PLAYLIST_ITEMS[@]}"}" "${OUTPUT_ARGS[@]+"${OUTPUT_ARGS[@]}"}" \
      "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}" "$URL"; then
    echo ""
    echo "✅ Descarga completada."
    trap - INT
  else
    rc=$?
    echo "❌ La descarga falló (código $rc). Si quedó a medias, reanuda con el mismo comando y URL." >&2
    trap - INT
    exit "$rc"
  fi
}

main "$@"