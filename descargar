#!/usr/bin/env bash
# Descarga videos o playlists de YouTube con yt-dlp actualizado.
# Verifica e instala automáticamente las dependencias necesarias:
#   - python3, curl, ffmpeg            (obligatorias)
#   - node / deno / bun                (runtime JS para YouTube, recomendado)
# Funciones:
#   - Detecta si el enlace es un video, una playlist o un video dentro de una playlist
#   - Si es playlist, pregunta cuántos videos descargar (todos / N / rango)
#   - Organiza las playlists en una carpeta con el nombre de la playlist
# Guarda los archivos en la carpeta desde donde ejecutes el script.
#
# CRÉDITOS: las descargas las realiza yt-dlp (https://github.com/yt-dlp/yt-dlp,
# licencia Unlicense). Este script es solo un wrapper: descarga el binario
# OFICIAL de yt-dlp desde sus releases y lo ejecuta. Este script no contiene
# ni modifica el código de yt-dlp.

set -euo pipefail

YTDLP="$HOME/.local/bin/yt-dlp"
MISSING_DEPS=""

# ============================================================
# 1) DETECTAR GESTOR DE PAQUETES DEL SISTEMA
# ============================================================
detect_pkgmgr() {
  if command -v apt-get >/dev/null 2>&1; then
    echo "apt"
  elif command -v dnf >/dev/null 2>&1; then
    echo "dnf"
  elif command -v yum >/dev/null 2>&1; then
    echo "yum"
  elif command -v pacman >/dev/null 2>&1; then
    echo "pacman"
  elif command -v zypper >/dev/null 2>&1; then
    echo "zypper"
  elif command -v apk >/dev/null 2>&1; then
    echo "apk"
  elif command -v pkg >/dev/null 2>&1 && command -v termux-info >/dev/null 2>&1; then
    echo "pkg"
  elif command -v brew >/dev/null 2>&1; then
    echo "brew"
  else
    echo ""
  fi
}

# Ejecuta un comando con privilegios de root (sudo si hace falta)
run_root() {
  if [[ $EUID -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "❌ Necesito permisos de root para instalar, pero no hay sudo disponible." >&2
    echo "   Ejecuta el script como root o instala sudo." >&2
    return 1
  fi
}

# Instala los paquetes dados según el gestor detectado
install_pkgs() {
  local pm="$1"
  shift
  case "$pm" in
    apt)   run_root apt-get update && run_root apt-get install -y "$@" ;;
    dnf)   run_root dnf install -y "$@" ;;
    yum)   run_root yum install -y "$@" ;;
    pacman) run_root pacman -S --noconfirm "$@" ;;
    zypper) run_root zypper --non-interactive install "$@" ;;
    apk)   run_root apk add "$@" ;;
    pkg)   run_root pkg install -y "$@" ;;
    brew)  brew install "$@" ;;
    *)
      echo "❌ No detecté un gestor de paquetes compatible." >&2
      echo "   Instala manualmente: python3, curl, ffmpeg y (opcional) node." >&2
      return 1
      ;;
  esac
}

# ============================================================
# 2) VERIFICAR E INSTALAR DEPENDENCIAS
# ============================================================
PKGMGR="$(detect_pkgmgr)"

ensure_cmd() {
  local cmd="$1"
  shift
  local pkgs=("$@")
  if command -v "$cmd" >/dev/null 2>&1; then
    echo "✅ $cmd detectado"
    return 0
  fi
  echo "⚠ $cmd NO está instalado → instalando..."
  if [[ -z "$PKGMGR" ]]; then
    echo "   (sin gestor de paquetes, instálalo manualmente)" >&2
    MISSING_DEPS+=" $cmd"
    return 1
  fi
  if install_pkgs "$PKGMGR" "${pkgs[@]}"; then
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "✅ $cmd instalado"
      return 0
    fi
  fi
  echo "❌ No se pudo instalar $cmd." >&2
  MISSING_DEPS+=" $cmd"
  return 1
}

echo "── Verificando dependencias ──"
ensure_cmd python3 python3
ensure_cmd curl curl
ensure_cmd ffmpeg ffmpeg
if command -v node >/dev/null 2>&1; then
  echo "✅ node detectado (runtime JS)"
elif command -v deno >/dev/null 2>&1; then
  echo "✅ deno detectado (runtime JS)"
elif command -v bun >/dev/null 2>&1; then
  echo "✅ bun detectado (runtime JS)"
else
  echo "⚠ Ningún runtime JS (node/deno/bun) → instalando nodejs..."
  if [[ -n "$PKGMGR" ]]; then
    install_pkgs "$PKGMGR" nodejs || MISSING_DEPS+=" nodejs"
  else
    MISSING_DEPS+=" nodejs"
  fi
fi

if [[ -n "$MISSING_DEPS" ]]; then
  echo "❌ Faltan dependencias que no pude instalar:$MISSING_DEPS" >&2
  echo "   Revisa la conexión a internet o instálalas manualmente y vuelve a ejecutar." >&2
  exit 1
fi

# ============================================================
# 3) ASEGURAR yt-dlp EN SU ÚLTIMA VERSIÓN
# ============================================================
if [[ ! -x "$YTDLP" ]]; then
  echo "▶ Instalando yt-dlp (última versión) en ~/.local/bin ..."
  mkdir -p "$HOME/.local/bin"
  curl -sL -o "$YTDLP" https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp
  chmod +x "$YTDLP"
fi

# JS runtime a usar para resolver los retos de YouTube
JS_ARGS=()
if command -v node >/dev/null 2>&1; then
  JS_ARGS=(--js-runtimes node)
elif command -v bun >/dev/null 2>&1; then
  JS_ARGS=(--js-runtimes bun)
fi

# ============================================================
# 4) PEDIR URL Y DETECTAR SU TIPO
# ============================================================
# Clasifica el enlace:
#   video          → video suelto (sin list=)
#   playlist       → URL de playlist pura (youtube.com/playlist?list=...)
#   video+playlist → video dentro de playlist (youtu.be/xxx?list=... o watch?v=...&list=...)
detect_url_type() {
  local url="$1"
  if [[ "$url" != *"list="* ]]; then
    echo "video"
  elif [[ "$url" == *"/playlist?"* ]]; then
    echo "playlist"
  else
    echo "video+playlist"
  fi
}

read -r -p "🔗 URL del video o playlist: " URL
if [[ -z "$URL" ]]; then
  echo "❌ No ingresaste ninguna URL." >&2
  exit 1
fi

URL_TYPE="$(detect_url_type "$URL")"

YES_PLAYLIST=()
NO_PLAYLIST=()
PLAYLIST_ITEMS=()
OUTPUT_ARGS=()
IS_PLAYLIST=0

case "$URL_TYPE" in
  video)
    ;;
  video+playlist)
    echo ""
    echo "⚠ Este enlace contiene un video Y una playlist. ¿Qué deseas descargar?"
    echo "  1) Solo el video"
    echo "  2) Toda la playlist"
    read -r -p "Elige [1]: " COMBO
    COMBO="${COMBO:-1}"
    case "$COMBO" in
      1)
        NO_PLAYLIST=(--no-playlist)
        ;;
      2)
        YES_PLAYLIST=(--yes-playlist)
        IS_PLAYLIST=1
        ;;
      *)
        echo "❌ Opción inválida: $COMBO" >&2
        exit 1
        ;;
    esac
    ;;
  playlist)
    YES_PLAYLIST=(--yes-playlist)
    IS_PLAYLIST=1
    ;;
esac

# ============================================================
# 5) CONFIGURAR DESCARGA DE PLAYLIST (si aplica)
# ============================================================
if [[ "$IS_PLAYLIST" -eq 1 ]]; then
  OUTPUT_ARGS=(-o '%(playlist_title)s/%(playlist_index 03d)s - %(title)s.%(ext)s')

  echo ""
  echo "▶ Consultando la playlist..."
  COUNT="$(timeout 30 "$YTDLP" --no-update --flat-playlist --yes-playlist \
    --print playlist_count "$URL" 2>/dev/null | head -1 || true)"

  echo ""
  if [[ "$COUNT" =~ ^[0-9]+$ ]]; then
    echo "  La playlist tiene $COUNT videos."
  else
    echo "  (no se pudo obtener el número de videos)"
  fi
  read -r -p "🎞 ¿Cuántos videos quieres descargar? (Enter = todos, N = primeros N, a-b = rango) [todos]: " QTY
  QTY="${QTY:-all}"

  case "$QTY" in
    all | todos)
      PLAYLIST_ITEMS=()
      ;;
    *)
      if [[ "$QTY" =~ ^[0-9]+$ ]]; then
        PLAYLIST_ITEMS=(--playlist-items "1-$QTY")
      elif [[ "$QTY" =~ ^[0-9]+-[0-9]+$ ]]; then
        PLAYLIST_ITEMS=(--playlist-items "$QTY")
      else
        echo "❌ Cantidad inválida: $QTY (usa: Enter, N o a-b)" >&2
        exit 1
      fi
      ;;
  esac
fi

# ============================================================
# 6) PEDIR RESOLUCIÓN
# ============================================================
echo ""
echo "Resoluciones disponibles:"
echo "  max            → máxima calidad disponible (por defecto)"
echo "  2160/1440/1080/720/480/360 → limitar a esa resolución"
echo "  audio          → solo audio en mp3"
read -r -p "🎚 Resolución [max]: " RES
RES="${RES:-max}"

EXTRA_ARGS=()
case "$RES" in
  max)
    FORMAT="bestvideo*+bestaudio/best"
    ;;
  audio)
    FORMAT="bestaudio/best"
    EXTRA_ARGS=(-x --audio-format mp3)
    ;;
  *)
    if [[ "$RES" =~ ^[0-9]+$ ]]; then
      FORMAT="bv*[height<="$RES"]+ba/b[height<="$RES"]"
    else
      echo "❌ Resolución inválida: $RES" >&2
      exit 1
    fi
    ;;
esac

# ============================================================
# 7) DESCARGAR
# ============================================================
echo ""
echo "▶ Descargando (resolución: $RES) ..."
"$YTDLP" --no-update "${JS_ARGS[@]+"${JS_ARGS[@]}"}" \
  -f "$FORMAT" \
  --retries 5 \
  "${YES_PLAYLIST[@]+"${YES_PLAYLIST[@]}"}" \
  "${NO_PLAYLIST[@]+"${NO_PLAYLIST[@]}"}" \
  "${PLAYLIST_ITEMS[@]+"${PLAYLIST_ITEMS[@]}"}" \
  "${OUTPUT_ARGS[@]+"${OUTPUT_ARGS[@]}"}" \
  "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}" \
  "$URL"